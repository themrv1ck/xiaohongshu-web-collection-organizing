{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "main_topic", "content_summary"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "main_topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^[\\u3400-\\u4DBF\\u4E00-\\u9FFF]"
          },
          "content_summary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 320,
            "pattern": "^[\\u3400-\\u4DBF\\u4E00-\\u9FFF]"
          }
        }
      }
    }
  }
}
